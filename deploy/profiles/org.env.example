# Profile: org — org administration (admin.atlassian.com), isolated in its own
# instance. 12 tools: utility + admin_org. Started only with
#   docker compose ... --profile org up -d
# (the service is opt-in in docker-compose.profiles.yml).
#
# The double gate applies as everywhere: the group must be enabled AND
# GOJIRA_ENABLE_ORG_ADMIN=true AND the caller's accountId must be allowlisted.
GOJIRA_INSTANCE_NAME=gojira-org
GOJIRA_ENABLED_GROUPS=utility,admin_org
GOJIRA_ENABLE_ORG_ADMIN=true
# Cloud Admin API key (admin.atlassian.com → Settings → API keys) + org id.
GOJIRA_ORG_ADMIN_TOKEN=
GOJIRA_ORG_ID=
# Comma-separated Atlassian accountIds allowed to invoke admin_org tools.
# REQUIRED non-empty; an empty list denies everyone (fails closed).
GOJIRA_ORG_ADMIN_ACCOUNT_IDS=
# Keep org-admin operations on their own audit stream.
GOJIRA_ORG_ADMIN_AUDIT_LOG_TARGET=stdout

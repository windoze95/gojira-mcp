# Profile: platform — Jira platform configuration. 51 tools: projects,
# permission/notification/workflow/issue-type schemes, screens, workflows,
# and custom fields, read+write. Project ARCHIVING is here; project DELETION
# is not — uncomment the alternate line to add it (52 tools).
GOJIRA_INSTANCE_NAME=gojira-platform
GOJIRA_ENABLED_GROUPS=utility,read_customfields,write_customfields,read_projects,write_projects,read_schemes,write_schemes,read_workflows,write_workflows
# With irreversible project deletion enabled:
# GOJIRA_ENABLED_GROUPS=utility,read_customfields,write_customfields,read_projects,write_projects,read_schemes,write_schemes,read_workflows,write_workflows,delete_projects

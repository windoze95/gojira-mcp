# Profile: readonly — the always-connected browse/audit surface. 26 tools:
# utility + every read_* group. No mutations beyond gojira.bindApiToken.
#
# This instance is also the fleet's OAuth callback anchor (port 8081 — see
# ATLASSIAN_CALLBACK_URI in shared.env): keep it running whenever any profile
# needs to complete an Atlassian consent.
GOJIRA_INSTANCE_NAME=gojira-readonly
GOJIRA_ENABLED_GROUPS=utility,read_jsm_admin,read_assets,read_automation,read_customfields,read_projects,read_schemes,read_workflows,read_confluence_admin,read_agile,read_filters_dashboards

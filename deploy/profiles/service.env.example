# Profile: service — run the service desk. 65 tools: JSM admin (request types,
# queues, organizations, forms), Assets/CMDB, and automation rules, read+write.
# Everything here that isn't OAuth-based rides the bound API token
# (gojira.bindApiToken once, on any instance — the binding is fleet-shared).
GOJIRA_INSTANCE_NAME=gojira-service
GOJIRA_ENABLED_GROUPS=utility,read_jsm_admin,write_jsm_admin,read_assets,write_assets,read_automation,write_automation

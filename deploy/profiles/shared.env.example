# Shared invariants for the split-surface profile fleet (docker-compose.profiles.yml).
#
# Setup:
#   cp deploy/profiles/shared.env.example    deploy/profiles/shared.env      # this file
#   cp deploy/profiles/readonly.env.example  deploy/profiles/readonly.env    # ...and each profile you run
#   docker compose -p gojira -f docker-compose.profiles.yml --env-file deploy/profiles/shared.env up -d --build
# `gojira` is the fresh-install example. On upgrade, reuse the project name that
# already owns Redis (for example, keep an existing `gojira-fleet` deployment on
# `gojira-fleet`). Changing it creates a different volume and strands credentials,
# OAuth clients, and token state.
#
# Do not replace a live shared.env with this template during upgrade. Merge new
# settings into it; older files must add GOJIRA_REFRESH_REUSE_POLICY explicitly
# before running `npm run preflight:profiles`.
#
# Every gojira-* service loads this file FIRST, then its own profile file
# (deploy/profiles/<name>.env). The fleet shares ONE Redis and ONE Atlassian
# OAuth app, so every value in this file must be IDENTICAL for all instances —
# `npm run preflight:profiles` enforces that plus the per-profile invariants.

# --- Reachability (compose interpolation; GOJIRA_HOST/SCHEME not read by the app) ---
# Each instance's MCP_SERVER_URL is pinned in docker-compose.profiles.yml as
# <GOJIRA_URL_SCHEME>://<GOJIRA_HOST>:<port> — keep ATLASSIAN_CALLBACK_URI
# below in sync with whatever you choose here.
#
# THE MCP SDK REFUSES http:// ISSUERS except for localhost/127.0.0.1 — a
# non-localhost http fleet crash-loops with "Issuer URL must be HTTPS".
# Pick ONE:
#
#  A) localhost (default) — clients on this machine, or remote clients via an
#     SSH tunnel / port-forward that makes the fleet look local to them.
GOJIRA_HOST=localhost
#
#  B) LAN hostname over PLAIN HTTP — what a private single-operator network
#     usually wants. Requires the SDK's explicit opt-out; bearer tokens then
#     travel unencrypted on that network, so keep it truly private.
# GOJIRA_HOST=gojira.internal.example.com
# MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true
#
#  C) LAN hostname over HTTPS — in-process TLS with your own CA. Put the cert
#     and key in deploy/profiles/certs/ (mounted read-only at /certs) and
#     trust the CA on client machines. The container healthcheck follows
#     HEALTHCHECK_PROTOCOL; a private CA fails wget's verification, so expect
#     to rely on `docker compose ps` + /health probes from a trusting client.
# GOJIRA_HOST=gojira.internal.example.com
# GOJIRA_URL_SCHEME=https
# TLS_CERT_PATH=/certs/gojira.crt
# TLS_KEY_PATH=/certs/gojira.key
# HEALTHCHECK_PROTOCOL=https

# Redis sidecar password (compose wires it into --requirepass and REDIS_URL).
REDIS_PASSWORD=

# --- Atlassian OAuth app: ONE app serves the whole fleet ---
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=

# Scope SUPERSET for the whole fleet. One app + one shared upstream credential
# (token:<accountId> in the shared Redis) means per-profile scope trimming is
# not possible — the last consent's scopes win for everyone. Tool-surface
# isolation comes from GOJIRA_ENABLED_GROUPS per profile, not from scopes.
ATLASSIAN_OAUTH_SCOPES=offline_access read:me read:account read:jira-work write:jira-work manage:jira-project manage:jira-configuration read:servicedesk-request read:cmdb-object:jira write:cmdb-object:jira read:cmdb-schema:jira write:cmdb-schema:jira read:cmdb-type:jira write:cmdb-type:jira read:cmdb-attribute:jira write:cmdb-attribute:jira delete:cmdb-object:jira delete:cmdb-schema:jira delete:cmdb-type:jira delete:cmdb-attribute:jira import:import-configuration:cmdb

# ONE callback URL for the whole fleet, registered VERBATIM on the Atlassian
# app. It is anchored on the readonly instance (port 8081): Atlassian always
# redirects there, and whichever instance started the flow completes it via
# the shared Redis (pending-auth state is instance-agnostic by design). The
# readonly instance must be RUNNING whenever any instance runs a consent.
# Match scheme+host to your reachability choice above; if the Atlassian dev
# console refuses a plain-http callback for your host, use variant C (https).
ATLASSIAN_CALLBACK_URI=http://localhost:8081/oauth/atlassian-callback

# Site pinning — same tenant for every profile. Strongly recommended.
ATLASSIAN_PINNED_CLOUD_ID=

# --- Foundation (identical everywhere) ---
# ONE key for the fleet. Instances share the encrypted credential stores
# (token:<accountId>, apitoken:<accountId>); a mismatched key makes the other
# instance's reads fail decryption and silently PURGE the credential.
TOKEN_ENCRYPTION_KEY=
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=*
# Pooled per-account across ALL instances (one shared Redis bucket): 60 means
# 60 calls/min TOTAL for the fleet, not per instance. Atlassian's own limits
# are per-user anyway, so pooling is the honest model.
RATE_LIMIT_PER_USER=60
GOJIRA_UI_ENABLED=true
GOJIRA_OPERATION_JOURNAL_TTL_DAYS=30
GOJIRA_AUDIT_LOG_TARGET=stdout

# Profile-fleet stale refresh-token policy. `contain` rejects a stale token,
# preserves the current successor family, and emits REFRESH_TOKEN_REUSE_CONTAINED
# for alert-and-investigate. This prevents a delayed shared Codex process from
# logging out every profile, but trades automatic family revocation for operator
# response. Set `strict` to revoke the whole family on reuse; the app and the
# single-instance compose path default to strict when this variable is absent.
GOJIRA_REFRESH_REUSE_POLICY=contain
